flowchart TB
  start(["User clicks download<br/>Client sends asset identifier only"])
  resolve["Server resolves trusted Publication + Asset<br/>Do not trust client-supplied access level / object key"]
  ready{"Asset processing status = ready?"}
  notready["No → fail safely<br/>Unavailable / retry message"]
  effective["Resolve effective policy<br/>Asset override vs publication inheritance [ADR]"]
  public{"Effective access = public?"}
  publicurl["Yes → return public asset URL<br/>No private signature needed"]
  auth{"Private access requires valid public-user session?"}
  login["No → authentication required<br/>Login / register return path"]
  ent["Evaluate entitlement<br/>scope · source · status · valid_from · valid_until"]
  allowed{"Entitlement allows asset?"}
  deny["No → deny / locked state<br/>Explain requirement without leaking internals"]
  sign["Yes → create short-lived signed URL<br/>Write minimal audit event"]
  note_1{"STAFF ACCESS IS SEPARATE: Payload staff role does not automatically grant public subscriber entitlement. Define an explicit staff policy or separate, auditable public-user grant."}
  start --> resolve
  resolve --> ready
  ready -->|No| notready
  ready -->|Yes| effective
  effective --> public
  public -->|Yes| publicurl
  public -->|No| auth
  auth -->|No| login
  auth -->|Yes| ent
  ent --> allowed
  allowed -->|No| deny
  allowed -->|Yes| sign
