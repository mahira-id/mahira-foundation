flowchart TB
  authuser(["SUPABASE AUTH USER<br/>auth.users<br/>Identity / email / session authority"])
  profile["PUBLIC USER PROFILE<br/>1:1 with Auth user<br/>Locale preference / minimal profile data"]
  entitlement["ENTITLEMENT<br/>Scope · source · status<br/>valid_from / valid_until"]
  download["DOWNLOAD EVENT / AUDIT<br/>User nullable only if anonymous analytics approved<br/>Asset/publication refs · decision · timestamp"]
  manual["MANUAL GRANT / REVOKE<br/>Staff action with actor + reason<br/>Pre-payment entitlement source"]
  contentref{"CONTENT SCOPE REFERENCE<br/>Publication / collection / plan / asset ref<br/>Stable ID · no client authority"}
  assetref["DOWNLOAD TARGET REFERENCE<br/>Publication ID + Asset ID<br/>Opaque reference to Payload content"]
  subscription["SUBSCRIPTION · PHASE 2<br/>Provider · plan · period<br/>status / cancellation / renewal"]
  payment["PAYMENT TRANSACTION · PHASE 2<br/>Provider reference · amount/currency<br/>status / reconciliation"]
  webhook["WEBHOOK EVENT LEDGER · PHASE 2<br/>Signature verified · idempotency key<br/>processed / retry / failure state"]
  note_1["SECURITY / DATA RULES: Auth owns credentials and identity. Application tables store only necessary profile and entitlement data. Users may read only their own permitted rows. Payment events never grant access from a browser redirect; verified server-side events update entitlement. Retention and anonymous event collection require privacy approval."]
  authuser -->|1 : 1| profile
  authuser -->|1 : N| entitlement
  authuser -->|0 : N| download
  manual -->|creates / revokes| entitlement
  entitlement -.->|scope reference| contentref
  download -.->|event reference| assetref
  authuser -.->|1 : N| subscription
  subscription -.->|1 : N| payment
  payment -.->|provider events| webhook
  subscription -.->|reconciles entitlement| entitlement
