flowchart TB
  prd["PRD / USER NEED<br/><br/>What outcome must exist?"]
  decision["DECISION / ADR<br/><br/>Why this solution?"]
  architecture["ARCHITECTURE SPECS<br/><br/>Data · access · integration"]
  spec["IMPLEMENTATION SPECS<br/><br/>Page · API · workflow"]
  code["CODE / CONFIG<br/><br/>Next · Payload · Supabase"]
  tests["TESTS & ACCEPTANCE<br/>Unit · integration · E2E · security · SEO · accessibility"]
  note_1["When a requirement changes, update the linked decision/specification and rerun affected tests. Do not let chat history become the only record of an accepted decision."]
  prd --> decision
  decision --> architecture
  architecture --> spec
  spec --> code
  code --> tests
  tests -.->|feedback / change impact| prd
  classDef root fill:#123B5D,stroke:#123B5D,color:#fff,stroke-width:2px;
  classDef domain fill:#DCEBFA,stroke:#1E6FB7,color:#101010,stroke-width:1.5px;
  classDef module fill:#EFF6FC,stroke:#A8C6E3,color:#101010;
  classDef action fill:#E4F2EC,stroke:#1B684C,color:#101010;
  classDef future fill:#EEE9FA,stroke:#7A68A6,color:#101010;
  classDef open fill:#FFF5D6,stroke:#C89A22,color:#101010;
  classDef warning fill:#FFF0E5,stroke:#FF6A00,color:#101010;
  classDef danger fill:#FCE8E6,stroke:#C65B52,color:#101010;
  class prd domain;
  class decision domain;
  class architecture domain;
  class spec domain;
  class code action;
  class tests warning;
  class note_1 neutral;
