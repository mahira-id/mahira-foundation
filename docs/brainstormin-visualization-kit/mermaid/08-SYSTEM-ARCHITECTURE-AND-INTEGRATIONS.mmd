  appdb["SUPABASE APP TABLES<br/>Profiles · entitlements · download events<br/>RLS"]
  storage["SUPABASE STORAGE<br/>Public assets bucket<br/>Private restricted-asset bucket"]
  postgres["SUPABASE POSTGRESQL<br/>Payload schema + application schema<br/>Separate migration / ownership boundaries"]
  publicfiles["Public assets<br/>public URL permitted"]
  privatefiles["Private assets<br/>server-issued signed URL"]
  email["EMAIL PROVIDER<br/>Resend / Brevo candidate<br/>SMTP & transactional email"]
  video["VIDEO / EXTERNAL CONTENT<br/>YouTube or approved embed provider"]
  monitor["OBSERVABILITY<br/>Sentry · uptime · structured logs"]
  host["HOSTING / CI-CD<br/>Vercel proposed · GitHub"]
  payment["PAYMENT PROVIDER · PHASE 2<br/>Xendit / Midtrans candidates"]
  note_1["SECURITY BOUNDARY: browser never receives service-role secrets or a trusted access decision. Private assets are never placed in public buckets; every private download is authorized server-side before signing."]
