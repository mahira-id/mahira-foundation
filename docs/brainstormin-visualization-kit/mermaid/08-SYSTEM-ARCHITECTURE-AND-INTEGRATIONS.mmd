flowchart TB
  browser(["BROWSER / CLIENT<br/>Public visitor · registered user · staff"])
  next["NEXT.JS APP ROUTER<br/>Public rendering · account UI · server routes/actions<br/>Locale routing · SEO · server-side authorization"]
