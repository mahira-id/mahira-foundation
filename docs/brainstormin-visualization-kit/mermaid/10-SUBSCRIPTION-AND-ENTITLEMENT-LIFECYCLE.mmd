flowchart TB
  mvp["MVP / PRE-PAYMENT<br/>Admin grants or revokes entitlement manually<br/>Effective access still uses common evaluator"]
  phase2["PHASE 2 · SUBSCRIPTION<br/>Commercial plan / provider / billing rules must be approved"]
  manual["Staff grant action<br/>Scope + valid_from / until"]
  manualaudit["Record actor + reason<br/>Revoke / expiry tracking"]
  manualent["Entitlement record<br/>Status + validity"]
  plan{"Plan / offer<br/>Price · duration · eligibility"}
  checkout["Checkout<br/>Provider hosted/API"]
  payment["Payment attempt / transaction<br/>Pending · paid · failed · refunded"]
  webhook["Verified webhook<br/>Signature / authenticity"]
  idempotent["Idempotency + event ledger<br/>Handle duplicate / delayed events"]
  subscription["Subscription state<br/>Active / past_due / canceled / expired [TBD]"]
  entitlement["Create / extend / revoke entitlement<br/>Server-side reconciliation"]
  access["Same access evaluator<br/>No payment checks in each route"]
  note_1{"NOT DECIDED: plan pricing, recurring vs manual renewal, payment methods, grace period, cancel/refund, tax/invoice, legal onboarding, and provider selection. Do not hard-code these into MVP."}
  mvp --> manual
  manual --> manualaudit
  manualaudit --> manualent
  phase2 --> plan
  plan --> checkout
  checkout --> payment
  payment --> webhook
  webhook --> idempotent
  idempotent --> subscription
  subscription --> entitlement
  entitlement --> access
  manualent -.->|same evaluator| access
